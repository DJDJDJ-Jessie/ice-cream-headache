{
  "name": "qqpet-windows-port",
  "version": "0.1.0",
  "private": true,
  "description": "QQPet desktop port for Windows 10 and Windows 11 using Electron and Ruffle.",
  "main": "desktop/main.js",
  "scripts": {
    "serve:web": "http-server . -a 127.0.0.1 -p 5173 -c-1",
    "start:desktop": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "local.qqpet.windows-port",
    "productName": "QQPet",
    "files": [
      "**/*",
      "!node_modules/.cache{,/**}",
      "!dist{,/**}",
      "!.git{,/**}"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "http-server": "^14.1.1"
  }
}
